{"lexicon" 1,
 "id" "com.etzhayyim.seigyo.alarmEventRecord",
 "description"
 "Full-fidelity alarm/event record flowing northbound from L2 SCADA. Alarms are operational facts, not personal telemetry — exempt from the §5 aggregate bucketing that applies to process waveforms. Per ADR-2606111000 §5 + §6.",
 "defs"
 {"main"
  {"type" "record",
   "record"
   {"type" "object",
    "properties"
    {"interlockMirror"
     {"type" "boolean",
      "description"
      "true when this alarm mirrors a hardwired L1S interlock state change (read-only visibility per ADR §3)"},
     "raisedAt" {"type" "string"},
     "note" {"type" "string"},
     "controllerId" {"type" "string"},
     "acknowledgedByDid" {"type" "string"},
     "valueMilli"
     {"type" "integer",
      "description"
      "process value at alarm in 1/1000 of unit (implied milli-units)"},
     "alarmTag" {"type" "string"},
     "state"
     {"type" "string",
      "knownValues" ["raised" "acknowledged" "cleared"]},
     "stateChangedAt" {"type" "string"},
     "unit" {"type" "string"},
     "severity"
     {"type" "string",
      "knownValues" ["info" "warning" "alarm" "critical"]},
     "siteId" {"type" "string"},
     "thresholdMilli"
     {"type" "integer",
      "description"
      "alarm threshold in 1/1000 of unit (implied milli-units)"}},
    "required"
    ["siteId"
     "controllerId"
     "alarmTag"
     "severity"
     "state"
     "raisedAt"]}}}}
