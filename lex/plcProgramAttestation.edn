     "stSourceCid"
     {"type" "string",
      "description" "CID of the canonical IEC 61131-3 ST source"},
     "controllerId" {"type" "string"},
     "programVersion" {"type" "integer"},
     "councilAttestationRef"
     {"type" "string",
      "description"
      "Council attestation reference (bootstrap: PR URL / merge commit per CLAUDE.md operational premise 2026-06-11)"},
